{
  "manifest_version": 3,
  "name": "Firefly Sidecar Amazon Sync",
  "version": "0.1.7",
  "default_locale": "en",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.amazon.es/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.es/*gp/your-account/order-history*",
        "https://*.amazon.es/*gp/css/order-history*",
        "https://*.amazon.es/*your-orders*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.amazon.es/*"
      ],
      "js": [
        "ready.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
