{
  "manifest_version": 3,
  "name": "Firefly Sidecar Amazon Sync",
  "version": "0.1.2",
  "default_locale": "en",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.amazon.es/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.es/*gp/your-account/order-history*",
        "https://*.amazon.es/*gp/css/order-history*",
        "https://*.amazon.es/*your-orders*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.amazon.es/*"
      ],
      "js": [
        "ready.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
