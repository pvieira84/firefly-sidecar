# Docker must be able to reach this address. For Firefly in the same Compose
# project, use its service name (e.g. http://app:8080), not localhost.
FIREFLY_URL=http://app:8080
FIREFLY_TOKEN=replace-with-your-personal-access-token
# Optional URL for display when internal and external URLs differ.
FIREFLY_PUBLIC_URL=http://localhost:8080
REIMBURSE_TAG=Reimburse
REIMBURSE_LINK_TYPE=Reimbursement
# Add the browser-facing host if accessing through a reverse proxy.
SIDECAR_HOSTS=localhost,127.0.0.1,[::1]
# Optional Basic Auth. Use HTTPS when accessing beyond localhost.
SIDECAR_USERNAME=sidecar
SIDECAR_PASSWORD=

# Exact tag identifying transactions awaiting validation (case-sensitive).
TODO_TAG=todo

# Optional: resolve ambiguity if Firefly exposes multiple Cash accounts.
CASH_ACCOUNT_ID=

# Refund search defaults; adjustable in the dialog. Tolerance is in deposit currency.
REFUND_LOOKBACK_DAYS=90
REFUND_AMOUNT_TOLERANCE=1.00

# Exact tag for pending Curve Go Back in Time matches.
GBIT_TAG=#GBIT

# Existing Firefly transaction link type names (case-sensitive).
GBIT_LINK_TYPE=GBIT
GBIT_REFUND_LINK_TYPE=GBIT Refund

# Public mount path when hosted at https://firefly.example.com/sidecar/
SIDECAR_BASE_PATH=
